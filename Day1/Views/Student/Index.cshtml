@{
   
}

@foreach(var item in Model)
{
    <div style="border:solid 1px red">
        <ul>
            <li>
                @item.Id
            </li>
        </ul>
        <ul>
            <li>
                @item.Name
            </li>
        </ul>
        <ul>
            <li>
                @item.Address
            </li>
        </ul>
        <ul>
            <li>
                <img src="/images/@item.Image" style="weight:100px,height:100px" />
            </li>
        </ul>


    </div>
}