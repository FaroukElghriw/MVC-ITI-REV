@{
}
@model List<Department>
<table class="table table-bordered table-hover">

    <thead
        <th>
            
                <td>
                    DepartmentName
                </td>
                 <td>
                    DepartmentManager
                </td>

        </th>
        
    </thead>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.ManagerName</td>
        </tr>
    }

</table>

